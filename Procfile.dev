backend: RAILS_ENV=development bundle exec rails server -b 0.0.0.0 -p 3000
worker: dotenv bundle exec sidekiq -C config/sidekiq.yml
vite: BUILD_MODE= CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=150 VITE_USE_POLLING=1 VITE_PORT=${VITE_PORT:-3036} VITE_HMR_HOST=127.0.0.1 VITE_RUBY_HOST=0.0.0.0 VITE_RUBY_PORT=${VITE_PORT:-3036} bin/vite dev
